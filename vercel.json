{
  "framework": null,
  "outputDirectory": ".",
  "functions": {
    "api/subscribe.js": {
      "memory": 128,
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/api/subscribe",
      "destination": "/api/subscribe.js"
    },
    {
      "source": "/catalog.json",
      "destination": "/public/catalog.json"
    },
    {
      "source": "/bundles.meta.json",
      "destination": "/public/bundles.meta.json"
    },
    {
      "source": "/images/:path*",
      "destination": "/public/images/:path*"
    }
  ]
}
