# Rainforest API — structured Amazon product/search data
# Sign up at https://www.rainforestapi.com
# Required for: product discovery, price refreshing, image downloads
RAINFOREST_API_KEY=your-rainforest-api-key

# Your Amazon Associates affiliate tag
AMAZON_PARTNER_TAG=guesstotal-20

# Optional: Claude API for auto-generating witty product comments
# Without this, default comments are used (still fun, just less personalized)
# ANTHROPIC_API_KEY=your-anthropic-api-key
